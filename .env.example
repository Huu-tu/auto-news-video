# ── API ──────────────────────────────────────────────────────────────────────
PORT=8080
# Token bắt buộc cho mọi request. Sinh bằng: openssl rand -hex 32
API_TOKEN=

# Thư mục làm việc của job (mỗi job một thư mục con)
WORK_DIR=./work

# ── Cơ sở dữ liệu (bảng lịch tạo video) ──────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/bantin
# Dùng cho test tầng DB. Bỏ trống thì test đó tự bỏ qua.
TEST_DATABASE_URL=

# ── Render ───────────────────────────────────────────────────────────────────
# Version CLI hyperframes, ghim cứng để render tất định
HYPERFRAMES_VERSION=0.7.86
RENDER_WORKERS=4
# Trần thời gian một job (ms). 90 phút.
JOB_TIMEOUT_MS=5400000

# ── Bộ hẹn giờ tạo video ─────────────────────────────────────────────────────
# BẮT BUỘC. VPS mặc định chạy UTC — không đặt thì hẹn 09:00 sẽ chạy lúc 16:00 giờ VN.
TZ=Asia/Ho_Chi_Minh
SCHEDULE_TICK_MS=30000
# Trễ quá ngưỡng này thì bỏ lỡ, không chạy bù nữa.
# Quy tắc chọn: >= số video hẹn trong ngày x 1.2 (mỗi video tốn 45-70 phút, chạy tuần tự).
SCHEDULE_GRACE_HOURS=8
SCHEDULE_MAX_ATTEMPTS=2
SCHEDULE_RETRY_DELAY_MS=300000

# ── ASR ──────────────────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_LANG=vi

# ── Claude Code (bước sinh chapters) ─────────────────────────────────────────
CLAUDE_BIN=claude
# Đặt =1 để bỏ qua LLM, luôn dùng bố cục fallback (hữu ích khi test pipeline)
PLAN_FALLBACK_ONLY=0
# Tham số truyền thêm cho `claude -p`. Bước này chỉ sinh văn bản, không dùng
# tool, nên thường không cần gì. Nếu môi trường VPS của bạn vẫn hiện prompt xin
# quyền (job sẽ treo tới timeout vì không có ai bấm), khai cờ bỏ qua ở đây:
#   CLAUDE_EXTRA_ARGS=--dangerously-skip-permissions
# Cân nhắc: cờ đó tắt mọi rào chắn cho tiến trình claude, chỉ nên dùng khi
# container đã bị cô lập (không mount thư mục nhạy cảm, không có credential thừa).
CLAUDE_EXTRA_ARGS=

# ── Google Drive (OAuth refresh token — tài khoản Gmail cá nhân) ─────────────
# Lấy 3 giá trị dưới bằng: npm run drive:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ID thư mục Drive mặc định (lấy từ URL thư mục). Job có thể ghi đè qua payload.drive.folder_id
GOOGLE_DRIVE_FOLDER_ID=

# ── Cảnh báo khi job FAIL (tuỳ chọn) ─────────────────────────────────────────
# Bắn POST JSON {job_id, error} tới URL này. Bỏ trống = không cảnh báo.
ALERT_WEBHOOK=
